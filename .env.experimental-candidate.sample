# Copy to a private file outside the repository and pass it with --env-file.
# This candidate is experimental and does not replace the incumbent deployment.

CANDIDATE_IMAGE_TAG=replace-with-git-sha
CANDIDATE_AGENT_PORT=18080
CANDIDATE_MCP_PORT=18002
CANDIDATE_API_KEY=replace-with-random-api-key

# Absolute host path. The file contains only the database password.
CANDIDATE_POSTGRES_PASSWORD_FILE=/absolute/path/groktocrawl-x-postgres-password

# The home-lab LiteLLM deployment on gpuslut01 supports the local model alias.
LLM_BASE_URL=https://gpuslut.brandyapple.com/v1
LLM_API_KEY=replace-with-private-litellm-key
LLM_MODEL=local
LLM_CALL_TIMEOUT=300

# SlopSearX search provider configuration.
BRAVE_API_KEY=replace-with-private-brave-key

# Frozen defaults for the first replacement candidate.
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_DIM=1024
ACTIVE_EMBED_MODEL=v_bge-m3
VECTOR_INDEX_MAX_DOCS=250000
SEMANTIC_INFERENCE_WORKERS=1
SEMANTIC_INFERENCE_QUEUE_SIZE=16
SEMANTIC_INFERENCE_ADMISSION_TIMEOUT_SECONDS=0.25
PGVECTOR_SHADOW_SCORE_TOLERANCE=0.0001
PGVECTOR_SHADOW_TIMEOUT_SECONDS=2
SCRAPER_MAX_BROWSER_CONCURRENCY=4
SCRAPER_BROWSER_POOL_ENABLED=false
LOG_LEVEL=INFO
